# =============================================================================
# EnternFlix — dev environment (docker compose)
#
# Usage: docker compose --env-file .env.dev up
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# --- Logging -----------------------------------------------------------------
NEXT_PUBLIC_ENABLE_LOGGING=true

# --- Site / SEO --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://dev.emm4bi8s.dev

# --- HTTP --------------------------------------------------------------------
NEXT_PUBLIC_HTTP_TIMEOUT_MS=10000

# --- Custom backend ----------------------------------------------------------
NEXT_PUBLIC_CUSTOM_API_URL=https://api-dev.emm4bi8s.dev/v1/

# --- Image CDN ---------------------------------------------------------------
NEXT_PUBLIC_CUSTOM_IMAGE_BASE_URL=https://cdn-dev.emm4bi8s.dev/

# --- Allowed image hosts -----------------------------------------------------
NEXT_PUBLIC_IMAGE_HOSTS=api.emm4bi8s.dev,api-dev.emm4bi8s.dev,cdn.emm4bi8s.dev,cdn-dev.emm4bi8s.dev

# --- Build identity ----------------------------------------------------------
NEXT_PUBLIC_APP_ENV=dev

# --- Docker image ------------------------------------------------------------
# ECR image built by CI. Pull with: aws ecr get-login-password | docker login ...
# Leave unset to build locally (docker compose up --build).
ENTERNFLIX_IMAGE=929910138721.dkr.ecr.us-east-1.amazonaws.com/enternflix:dev-latest
