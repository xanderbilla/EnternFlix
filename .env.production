# Production environment variables - used by Next.js during build
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_ENABLE_LOGGING=false
NEXT_PUBLIC_SITE_URL=https://enternflix.amplifyapp.com
NEXT_PUBLIC_HTTP_TIMEOUT_MS=10000
NEXT_PUBLIC_CUSTOM_API_URL=http://localhost:8080/v1
NEXT_PUBLIC_CUSTOM_IMAGE_BASE_URL=https://bi8s-storage-dev.s3.us-east-1.amazonaws.com/
NEXT_PUBLIC_IMAGE_HOSTS=
NEXT_PUBLIC_APP_ENV=prod
