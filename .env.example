# =============================================================================
# EnternFlix — Environment Variables
#
# Local dev:        copy to `.env.local`     (Next.js auto-loads, gitignored)
# Docker compose:   copy to `.env`           (consumed by docker-compose)
# Production:       set via your platform's secret manager (Vercel, ECS, etc.)
#
# Only NEXT_PUBLIC_* values reach the browser. Never put secrets behind that
# prefix. Required vars are validated at startup (see src/lib/env/env.ts).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# Port for `next start` and the Docker container. Defaults to 3000.
PORT=3000
# Hostname `next start` binds to. Use 0.0.0.0 inside containers.
HOSTNAME=0.0.0.0

# --- Logging -----------------------------------------------------------------
# Toggles client-side debug/info/warn logs. Errors are always emitted.
NEXT_PUBLIC_ENABLE_LOGGING=true

# --- Site / SEO --------------------------------------------------------------
# Public site origin. Used for canonical URLs, OpenGraph, sitemap, and robots.
# Local dev:    http://localhost:3000
# Production:   https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- HTTP --------------------------------------------------------------------
# Per-request axios timeout (ms). Defaults to 10000.
NEXT_PUBLIC_HTTP_TIMEOUT_MS=10000

# --- Custom backend ----------------------------------------------------------
# Local dev:    http://localhost:8080/v1
# Docker (host->container backend): http://host.docker.internal:8080/v1
# Production:   https://api.yourdomain.com/v1
NEXT_PUBLIC_CUSTOM_API_URL=http://localhost:8080/v1

# --- Image CDN ---------------------------------------------------------------
# Base URL for backend images. Must end with a slash.
NEXT_PUBLIC_CUSTOM_IMAGE_BASE_URL=https://your-cdn.example.com/

# --- Allowed image hosts -----------------------------------------------------
# Comma-separated list of additional hostnames (or full URLs) allowed by
# next/image. The CDN host above is added automatically.
NEXT_PUBLIC_IMAGE_HOSTS=

# --- Build identity ----------------------------------------------------------
# Injected by CI from `.version.<env>`. Leave empty locally; the footer falls
# back to "v0.0.0-local". Format: vX.Y.Z
NEXT_PUBLIC_APP_VERSION=
# Deployment environment label shown alongside the version. "dev" | "prod".
NEXT_PUBLIC_APP_ENV=

# =============================================================================
# CI/CD — GitHub Actions + AWS ECR
# These values live in GitHub repository settings, NOT in this file. Listed
# here as documentation of what the pipeline expects.
# =============================================================================
#
# GitHub Actions Variables (Settings -> Secrets and variables -> Actions -> Variables):
#   AWS_REGION              e.g. us-east-1
#   ECR_REPOSITORY          e.g. enternflix
#   ECR_REGISTRY            e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com
#
# GitHub Actions Secrets:
#   AWS_ROLE_ARN            arn:aws:iam::<acct>:role/<gha-oidc-role>
#
# Optional build-time variables (Variables, NOT secrets — these are NEXT_PUBLIC_*):
#   BUILD_NEXT_PUBLIC_CUSTOM_API_URL
#   BUILD_NEXT_PUBLIC_CUSTOM_IMAGE_BASE_URL
#   BUILD_NEXT_PUBLIC_SITE_URL
#   BUILD_NEXT_PUBLIC_IMAGE_HOSTS
# =============================================================================
