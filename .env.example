# =============================================================================
# EnternFlix — Environment Variables
#
# Local dev:        copy to `.env.local`     (Next.js auto-loads, gitignored)
# Docker compose:   copy to `.env`           (consumed by docker-compose)
# Production:       set via your platform's secret manager (Vercel, ECS, etc.)
#
# Only NEXT_PUBLIC_* values reach the browser. Never put secrets behind that
# prefix. Required vars are validated at startup (see src/config/env.ts).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# Port for `next start` and the Docker container. Defaults to 3000.
PORT=3000
# Hostname `next start` binds to. Use 0.0.0.0 inside containers.
HOSTNAME=0.0.0.0

# --- Logging -----------------------------------------------------------------
# Toggles client-side debug/info/warn logs. Errors are always emitted.
NEXT_PUBLIC_ENABLE_LOGGING=true

# --- HTTP --------------------------------------------------------------------
# Per-request axios timeout (ms). Defaults to 10000.
NEXT_PUBLIC_HTTP_TIMEOUT_MS=10000

# --- TMDB --------------------------------------------------------------------
# Get a key at https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
# Override only if you proxy TMDB.
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3

# --- Custom backend ----------------------------------------------------------
# Local dev:    http://localhost:8080/v1
# Docker (host->container backend): http://host.docker.internal:8080/v1
# Production:   https://api.yourdomain.com/v1
NEXT_PUBLIC_CUSTOM_API_URL=http://localhost:8080/v1

# --- Image CDN ---------------------------------------------------------------
# Base URL for non-TMDB images. Must end with a slash.
NEXT_PUBLIC_CUSTOM_IMAGE_BASE_URL=https://your-cdn.example.com/

# --- Allowed image hosts -----------------------------------------------------
# Comma-separated list of additional hostnames (or full URLs) allowed by
# next/image. The CDN host above and TMDB are added automatically.
NEXT_PUBLIC_IMAGE_HOSTS=
